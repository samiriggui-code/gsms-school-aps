{
  "id": "a1b1c1d1-e002-4000-8000-000000000002",
  "name": "GSMS — Cron stats (équiv. worker)",
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [{ "field": "hours", "hoursInterval": 1 }] }
      },
      "id": "b2000001-0001-4000-8000-000000000001",
      "name": "Chaque heure",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 200]
    },
    {
      "parameters": {
        "url": "http://gsms-crm:3001/api/dashboard/stats",
        "options": { "timeout": 30000 }
      },
      "id": "b2000001-0002-4000-8000-000000000002",
      "name": "GET dashboard stats",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [260, 200],
      "onError": "continueRegularOutput",
      "notesInFlow": true,
      "notes": "URL interne Docker gsms-crm:3001"
    },
    {
      "parameters": {
        "url": "http://gsms-crm:3001/api/sections/gestion-academique/vie-scolaire/stats",
        "options": { "timeout": 30000 }
      },
      "id": "b2000001-0003-4000-8000-000000000003",
      "name": "GET vie-scolaire stats",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [520, 200],
      "onError": "continueRegularOutput",
      "notesInFlow": true,
      "notes": "401 sans session = normal (sonde connectivité)"
    },
    {
      "parameters": {
        "jsCode": "const vs = $input.first().json ?? {};\nconst dash = $('GET dashboard stats').first().json ?? {};\nconst dashCode = dash.statusCode ?? (dash.success === true ? 200 : dash.error ? 0 : 200);\nconst vsCode = vs.statusCode ?? (vs.success === true ? 200 : vs.error ? 0 : 401);\nreturn [{\n  json: {\n    mirroredFrom: 'packages/workers/stats-aggregator.ts',\n    dashboardOk: dash.success === true,\n    dashboardHttp: dashCode,\n    vieScolaireStatus: vs.success === true ? 'ok' : vsCode === 401 ? 'auth_required' : 'error',\n    vieScolaireHttp: vsCode,\n    at: new Date().toISOString()\n  }\n}];"
      },
      "id": "b2000001-0004-4000-8000-000000000004",
      "name": "Synthèse",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [780, 200]
    }
  ],
  "connections": {
    "Chaque heure": {
      "main": [[{ "node": "GET dashboard stats", "type": "main", "index": 0 }]]
    },
    "GET dashboard stats": {
      "main": [[{ "node": "GET vie-scolaire stats", "type": "main", "index": 0 }]]
    },
    "GET vie-scolaire stats": {
      "main": [[{ "node": "Synthèse", "type": "main", "index": 0 }]]
    }
  },
