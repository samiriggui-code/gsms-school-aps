{
  "id": "a1b1c1d1-e003-4000-8000-000000000003",
  "name": "GSMS — Sonde apps (5 min)",
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [{ "field": "minutes", "minutesInterval": 5 }] }
      },
      "id": "c3000001-0001-4000-8000-000000000001",
      "name": "Toutes les 5 min",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 300]
    },
    {
      "parameters": {
        "url": "http://gsms-landing:3000/",
        "options": { "response": { "response": { "fullResponse": true } }, "timeout": 15000 }
      },
      "id": "c3000001-0002-4000-8000-000000000002",
      "name": "Landing",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [260, 300],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "url": "http://gsms-crm:3001/api/health",
        "options": { "response": { "response": { "fullResponse": true } }, "timeout": 15000 }
      },
      "id": "c3000001-0003-4000-8000-000000000003",
      "name": "CRM health",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [520, 300],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "url": "http://gsms-docs:3004/introduction",
        "options": { "response": { "response": { "fullResponse": true } }, "timeout": 15000 }
      },
      "id": "c3000001-0004-4000-8000-000000000004",
      "name": "Docs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [780, 300],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "function probe(name, nodeName) {\n  let j = {};\n  try {\n    j = $(nodeName).first().json ?? {};\n  } catch {\n    j = {};\n  }\n  const status = j.statusCode ?? j.status ?? 0;\n  const up = status >= 200 && status < 400;\n  return { service: name, status, state: up ? 'UP' : 'DOWN', color: up ? 'green' : 'orange' };\n}\nreturn [{\n  json: {\n    checkedAt: new Date().toISOString(),\n    probes: [\n      probe('landing', 'Landing'),\n      probe('crm', 'CRM health'),\n      probe('docs', 'Docs'),\n    ],\n    via: 'docker-internal'\n  }\n}];"
      },
      "id": "c3000001-0005-4000-8000-000000000005",
      "name": "Tableau UP/DOWN",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1040, 300]
    }
  ],
  "connections": {
    "Toutes les 5 min": {
      "main": [[{ "node": "Landing", "type": "main", "index": 0 }]]
    },
    "Landing": {
      "main": [[{ "node": "CRM health", "type": "main", "index": 0 }]]
    },
    "CRM health": {
      "main": [[{ "node": "Docs", "type": "main", "index": 0 }]]
    },
    "Docs": {
      "main": [[{ "node": "Tableau UP/DOWN", "type": "main", "index": 0 }]]
    }
  },
  "active": true,
  "settings": { "executionOrder": "v1" },
  "tags": [{ "name": "GSMS" }, { "name": "monitoring" }]
}
