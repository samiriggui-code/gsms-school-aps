# Build : docker build -f deploy/gsms/Dockerfile.worker -t gsms-worker:latest .
FROM node:22-bookworm-slim AS base
RUN apt-get update -qq && apt-get install -y -qq openssl ca-certificates && rm -rf /var/lib/apt/lists/*
RUN corepack enable && corepack prepare pnpm@11.5.1 --activate
WORKDIR /app

FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY packages ./packages
COPY patches ./patches
ENV DATABASE_URL="postgresql://lms:lms@localhost:5432/lms_app"
RUN pnpm install --frozen-lockfile
RUN pnpm db:generate

FROM base AS runner
WORKDIR /app
ENV NODE_ENV=production
COPY --from=deps /app ./
CMD ["pnpm", "--filter", "@repo/workers", "start"]
