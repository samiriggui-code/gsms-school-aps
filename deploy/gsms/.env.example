# Copier vers /opt/gsms/.env sur le VPS (ou generer via scripts/1-etape-preparer-fichiers.ps1)
# Ne jamais committer le .env de production.

POSTGRES_USER=lms
POSTGRES_PASSWORD=change-me
POSTGRES_PASSWORD_ENCODED=change-me
POSTGRES_DB=lms_app

MINIO_ROOT_USER=lms
MINIO_ROOT_PASSWORD=change-me
S3_BUCKET=lms-uploads

SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=admin@example.com
SMTP_PASS=
SMTP_FROM=admin@example.com
SMTP_SENDER=FORM'SSI

NEXTAUTH_URL=https://crm.example.com
NEXTAUTH_SECRET=
AUTH_SECRET=
NEXT_PUBLIC_CRM_URL=https://crm.example.com
NEXT_PUBLIC_LANDING_URL=https://example.com
NEXT_PUBLIC_SITE_URL=https://example.com

HOMEPAGE_ALLOWED_HOSTS=monitoring.example.com,portainer.example.com,uptime.example.com
NETDATA_HOSTNAME=gsms

DOMAIN=example.com
CRM_HOST=crm.example.com
DOCS_HOST=docs.example.com
MONITORING_HOST=monitoring.example.com
PORTAINER_HOST=portainer.example.com
UPTIME_HOST=uptime.example.com
NETDATA_HOST=netdata.example.com
SERVER_IP=0.0.0.0
SCHEME=https
