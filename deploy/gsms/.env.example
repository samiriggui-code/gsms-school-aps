# Template production — copier vers /opt/gsms/.env sur le VPS (hors Git)
# cp deploy/gsms/.env.example deploy/gsms/.env  → renseigner les secrets → scp vers le VPS
#
# POSTGRES_PASSWORD_ENCODED = même mot de passe que POSTGRES_PASSWORD, URL-encodé
#   ex. "P@ss!" → P%40ss%21

# --- PostgreSQL ---
POSTGRES_USER=lms
POSTGRES_PASSWORD=change_me
POSTGRES_PASSWORD_ENCODED=change_me
POSTGRES_DB=lms_app
DATABASE_URL=postgresql://lms:change_me@postgres:5432/lms_app
DIRECT_URL=postgresql://lms:change_me@postgres:5432/lms_app

# --- MinIO / S3 ---
MINIO_ROOT_USER=lms
MINIO_ROOT_PASSWORD=change_me
STORAGE_TYPE=s3
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY_ID=lms
STORAGE_SECRET_ACCESS_KEY=change_me
STORAGE_ENDPOINT=http://minio:9000
STORAGE_FORCE_PATH_STYLE=true
STORAGE_BUCKET=lms-uploads
STORAGE_CDN_URL=https://app.example.com/api/public/storage
# Console MinIO admin (optionnel — lien gouvernance + monitoring)
# Ex. tunnel SSH : ssh -L 9001:127.0.0.1:9001 root@VPS puis http://localhost:9001
STORAGE_MINIO_CONSOLE_URL=

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- SMTP (Hostinger) ---
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@example.com
SMTP_PASS=change_me
SMTP_FROM=noreply@example.com
SMTP_SENDER=FORMSSI
CONTACT_TO_EMAIL=contact@example.com
CONTACT_SEND_USER_CONFIRMATION=true

# --- Auth / URLs publiques (FQDN client — une seule base pour tout le monorepo) ---
# Changer le domaine : mettre à jour ces URLs puis rebuild Docker (deploy.sh lit NEXT_PUBLIC_SITE_URL).
# Les liens docs dans le CRM utilisent des chemins relatifs (/docs/...) — pas de localhost en prod.
NEXTAUTH_URL=https://app.example.com
NEXTAUTH_SECRET=change_me
AUTH_SECRET=change_me
NEXT_PUBLIC_SITE_URL=https://app.example.com
NEXT_PUBLIC_CRM_URL=https://app.example.com
NEXT_PUBLIC_LANDING_URL=https://app.example.com
# Optionnel : docs sur un autre host (sinon = NEXT_PUBLIC_SITE_URL + /docs)
# NEXT_PUBLIC_LMS_DOCS_URL=https://docs.client.example.com

# --- Pusher (optionnel) ---
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=eu
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=eu

# --- Worker PDF (Playwright dans gsms-worker) ---
REPORT_APP_BASE_URL=http://gsms-app:3001
PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=/ms-playwright/chromium-1169/chrome-linux/chrome

# --- Mux (lecteur vidéo e-formation — signing keys depuis dashboard Mux) ---
MUX_SIGNING_KEY_ID=
MUX_SIGNING_PRIVATE_KEY=

# --- Publication cours formateur (false = publication directe) ---
LMS_CONTENT_REVIEW_REQUIRED=false

# --- n8n workflows (instance externe ou Docker sur le VPS) ---
WORKFLOWS_N8N_ENABLED=false
WORKFLOWS_N8N_STANDARD_ENABLED=true
# URL publique instance n8n (sans slash final)
N8N_PUBLIC_URL=https://n8n.example.com
# API REST n8n — Settings → n8n API → Create API key
N8N_API_URL=https://n8n.example.com
N8N_API_KEY=
# URL Docker interne CRM (n8n → app, même VPS). Défaut recommandé : http://gsms-app:3001
# Le domaine public ne résout souvent pas depuis le conteneur n8n.
N8N_CRM_INTERNAL_URL=http://gsms-app:3001
# Secret partagé CRM ↔ n8n (généré au 1er deploy si vide)
N8N_WEBHOOK_SECRET=
N8N_WEBHOOK_STANDARD_SECRET=
# Écrit automatiquement par deploy/gsms/n8n/provision.mjs si absent
N8N_WEBHOOK_STANDARD_URL=https://n8n.example.com/webhook/gsms/standard
# Email ops pour alertes n8n → CRM
GSMS_OPS_EMAIL=
# Optionnel — chat ops (seed packages/database/scripts/seed-gsms-ops-chat.js)
GSMS_OPS_CHAT_CONVERSATION_ID=
N8N_SYSTEM_USER_ID=

# --- Domaine / Traefik / monitoring ---
DOMAIN=app.example.com
CRM_HOST=app.example.com
MONITORING_HOST=monitoring.example.com
SERVER_IP=your.vps.ip
HOMEPAGE_ALLOWED_HOSTS=monitoring.example.com,your.vps.ip,localhost
EXTERNAL_TRAEFIK=true
TRAEFIK_DYNAMIC_DIR=/opt/traefik/dynamic
TRAEFIK_CONTAINER_NAME=traefik-mvbo-traefik-1

# --- Sentry (laisser vide = désactivé en prod) ---
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
