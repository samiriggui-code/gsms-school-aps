# Build : docker build -f deploy/gsms/Dockerfile.landing -t gsms-landing:latest .
FROM node:22-bookworm-slim AS base
RUN apt-get update -qq && apt-get install -y -qq openssl ca-certificates && rm -rf /var/lib/apt/lists/*
RUN corepack enable && corepack prepare pnpm@11.5.1 --activate
WORKDIR /app

FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY apps/lms-landing/package.json apps/lms-landing/
COPY apps/lms-crm/package.json apps/lms-crm/
COPY packages ./packages
COPY apps/lms-landing ./apps/lms-landing
COPY patches ./patches
ENV DATABASE_URL="postgresql://lms:lms@localhost:5432/lms_app"
RUN pnpm install --frozen-lockfile
RUN pnpm db:generate
RUN pnpm --filter @lms-landing build

FROM node:22-bookworm-slim AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME=0.0.0.0
RUN addgroup --system --gid 1001 nodejs && adduser --system --uid 1001 nextjs
COPY --from=deps --chown=nextjs:nodejs /app/apps/lms-landing/.next/standalone ./
COPY --from=deps --chown=nextjs:nodejs /app/apps/lms-landing/.next/static ./apps/lms-landing/.next/static
COPY --from=deps --chown=nextjs:nodejs /app/apps/lms-landing/public ./apps/lms-landing/public
USER nextjs
EXPOSE 3000
CMD ["node", "apps/lms-landing/server.js"]
