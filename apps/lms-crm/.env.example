# Prisma — DB unique monorepo `lms_app` (schema dans packages/database).
# Copier DATABASE_URL / DIRECT_URL depuis `.env` à la racine du monorepo :
# DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/lms_app?schema=public"
# DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:5432/lms_app?schema=public"

# Next Auth Config #
# Côté client : ne pas mettre d’URL http(s) vers localhost ici (cassé sur mobile / LAN).
# Laisser vide à la racine, ou uniquement un préfixe de chemin : NEXT_PUBLIC_BASE_PATH=/sous-chemin
# NEXT_PUBLIC_API_URL n’est pas utilisé par l’app : utiliser des chemins relatifs `/api/...`.
NEXT_PUBLIC_BASE_PATH=
# Pour tester depuis le téléphone : NEXTAUTH_URL=http://VOTRE_IP_LAN:3001  (port du CRM)
# ALLOWED_DEV_ORIGINS=192.168.1.6  puis pnpm dev:lan
NEXTAUTH_URL=http://localhost:3001/
NEXTAUTH_SECRET=change-me-generate-with-openssl-rand-hex-32

# Lien « plaquette client » signé (/p/devis/.../plaquette?t=...). En prod : secret dédié (openssl rand -hex 32).
# Si vide, signature avec NEXTAUTH_SECRET (pratique en local si le devis a une formation liée).
DEVIS_PLAQUETTE_LINK_SECRET=

# Lien « enquête satisfaction » stagiaire signé (/p/satisfaction/...?t=...). En prod : secret dédié (openssl rand -hex 32).
# Si vide, signature avec NEXTAUTH_SECRET.
SATISFACTION_SURVEY_LINK_SECRET=

# Nom affiché « émetteur » sur la plaquette (sinon : providerName de la formation).
NEXT_PUBLIC_ORG_DISPLAY_NAME=

# Storage — MinIO local (docker compose -f docker-compose.storage.yml up -d)
# Sans MinIO : laisser vide ou commenter → fichiers dans public/uploads/ (dev uniquement).
# Chemin absolu optionnel si plusieurs process (worker + CRM) : même dossier partagé.
# STORAGE_LOCAL_ROOT=C:/laragon/www/gsms-school/apps/lms-crm/public/uploads
STORAGE_TYPE=minio
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=minioadmin
STORAGE_REGION=us-east-1
STORAGE_BUCKET=lms-app
STORAGE_ENDPOINT=http://127.0.0.1:9000
STORAGE_FORCE_PATH_STYLE=true
# URLs servies par le proxy Next (évite d'exposer MinIO au navigateur)
STORAGE_CDN_URL=http://localhost:3001/api/public/storage

# DigitalOcean Spaces (prod) — exemple :
# STORAGE_TYPE=digitalocean
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
# STORAGE_REGION=ams3
# STORAGE_BUCKET=
# STORAGE_ENDPOINT=https://ams3.digitaloceanspaces.com
# STORAGE_FORCE_PATH_STYLE=false
# STORAGE_CDN_URL=https://cdn.votre-domaine.fr

# SMTP — dev local : Mailpit (https://github.com/axllent/mailpit) sur 127.0.0.1:1025
# Origine des images dans les e-mails (logo header). En local : CRM sur 3001.
# EMAIL_ASSETS_ORIGIN=http://localhost:3001
# Laisser SMTP_HOST commenté OU utiliser 127.0.0.1 — ne pas garder your_smtp_host (ignoré en dev).
# SMTP_HOST=127.0.0.1
# SMTP_PORT=1025
# SMTP_SECURE=false
# SMTP_FROM=noreply@ecole.local
# Prod (ex. Hostinger) :
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=no-reply@votre-domaine.fr
# SMTP_PASS=
# SMTP_SENDER=FORM'SSI
# Ne pas utiliser Metronic / no-reply@domain.com (valeurs template) — ignorées automatiquement.
# SMTP_FROM=no-reply@votre-domaine.fr

# Google reCAPTCHA v2
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_public_recaptcha_site_key
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key

# Base URL
BASE_URL = /

# Dev local : évite redis-server Laragon (cache api-core en mémoire dans le process Node).
# REDIS_CACHE_DISABLED=1
# REDIS_URL=redis://127.0.0.1:6379

# Mux — lecteur vidéo signé (e-formation). Dashboard → Settings → Signing Keys
# Les IDs démo (ex. x36xhzz) pointent vers test-streams.mux.dev, pas stream.mux.com.
# Vos propres assets uploadés sur votre compte Mux : JWT requis si signing keys renseignées.
MUX_SIGNING_KEY_ID=your_mux_signing_key_id
MUX_SIGNING_PRIVATE_KEY=

# Si true : publication formateur → file validation admin (Contenu e-formation)
LMS_CONTENT_REVIEW_REQUIRED=false

# Pusher — temps réel (dashboard Pusher.com → App Keys)
PUSHER_APP_ID=your_pusher_app_id
PUSHER_KEY=your_pusher_key
PUSHER_SECRET=your_pusher_secret
PUSHER_CLUSTER=eu
NEXT_PUBLIC_PUSHER_KEY=your_pusher_key
NEXT_PUBLIC_PUSHER_CLUSTER=eu

# DocType V2 runtime (G1-D+). Default ON in code. Rollback explicit:
# DOCTYPE_V2_RUNTIME=0
# DOCTYPE_V2_RUNTIME=1

# Rapports PDF (worker Playwright → page /reports/render)
REPORT_APP_BASE_URL=http://localhost:3001
# REPORT_WORKER_DISABLED=1