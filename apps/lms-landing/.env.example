# Copier vers .env.local — même DB que le CRM : `lms_app` (voir `.env` racine monorepo).
# DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/lms_app?schema=public"
# DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:5432/lms_app?schema=public"

# --- Production — Hostinger (obligatoire si NODE_ENV=production) ---
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=admin@gsms-security.com
# SMTP_PASS=
# SMTP_FROM=admin@gsms-security.com
# SMTP_SENDER=GSMS Security

# --- Optionnel ---
# CONTACT_TO_EMAIL=contact-formssi@gmail.com
# CONTACT_SEND_USER_CONFIRMATION=true
# NEXT_PUBLIC_SITE_URL=https://formssi.online

# Test depuis téléphone / autre PC sur le LAN (HMR Next.js) :
# ALLOWED_DEV_ORIGINS=192.168.1.6
# Puis : pnpm dev:lan  (écoute 0.0.0.0:3000)

# En développement, sans variables : repli automatique Mailpit 127.0.0.1:1025 + noreply@localhost
# Lance Mailpit (ou équivalent) avant de tester le formulaire contact.

# --- Workflows (bus événements + n8n) ---
# Local : laisser false ou absent — prod VPS : true
# WORKFLOWS_N8N_STANDARD_ENABLED=true
# N8N_WEBHOOK_STANDARD_URL=https://n8n.example.com/webhook/standard/gsms
# N8N_WEBHOOK_BASE=https://n8n.example.com
# WORKFLOWS_N8N_ENABLED=false
# N8N_WEBHOOK_URL=https://n8n.example.com/webhook/gsms-events
# N8N_WEBHOOK_SECRET=
