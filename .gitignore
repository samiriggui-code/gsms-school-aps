.vercel
# Monorepo pnpm uniquement — évite que Next.js patche un vieux package-lock npm
package-lock.json
**/package-lock.json
scripts/.deploy-staging/
scripts/.deploy-staging-onboarding/
scripts/deploy.config.json
deploy/gsms/.env
deploy/gsms/SECRETS.txt

# Dépendances & caches
node_modules/
.pnpm-store/
.turbo/

# Secrets & env local (garder les .env.example)
.env
.env.*
!.env.example

# Builds Next / artefacts
.next/
out/
dist/
build/
*.tsbuildinfo

# Logs & OS
*.log
.DS_Store
Thumbs.db

# IDE / éditeur
.idea/
*.swp
*.swo
