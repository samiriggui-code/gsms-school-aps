.vercel
# Monorepo pnpm uniquement — évite que Next.js patche un vieux package-lock npm
package-lock.json
**/package-lock.json
scripts/.deploy-staging/
scripts/.deploy-staging-onboarding/
scripts/deploy.config.json
deploy/gsms/.env
deploy/gsms/SECRETS.txt
deploy/gsms/config/deploy.local.json

# Dépendances & caches
node_modules/
.pnpm-store/
.turbo/

# Secrets & env local (garder les .env.example)
.env
.env.*
!.env.example

# Builds Next / artefacts
.next/
out/
dist/
build/
*.tsbuildinfo

# Archives déploiement SCP (scripts/pack-for-vps.ps1)
gsms-school-*.tar.gz

# Fichiers médias uploadés en local (ne pas versionner)
apps/lms-crm/public/uploads/**
!apps/lms-crm/public/uploads/**/.keep
!apps/lms-crm/public/uploads/**/.gitkeep
!apps/lms-crm/public/uploads/.gitkeep

# Artefacts temporaires
tmp-landing.html

# Logs & OS
*.log
.DS_Store
Thumbs.db

# IDE / éditeur
.idea/
*.swp
*.swo
.claude/settings.local.json
