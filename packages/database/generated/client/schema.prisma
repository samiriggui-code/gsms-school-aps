generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  output          = "../generated/client"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  INACTIVE
  ACTIVE
  BLOCKED
  PENDING
  BANNED
  ABSENT
}

enum UserCategory {
  INTERNAL
  CLIENT
  SUBCONTRACTOR
}

enum WorkTimeType {
  FULL_TIME
  PART_TIME
}

enum ContractType {
  CDI
  CDD
  INTERIM
  STAGE
}

enum FileAssetVisibility {
  PRIVATE
  INTERNAL
  PUBLIC
}

enum FileAssetStatus {
  ACTIVE
  DELETED
  ARCHIVED
}

enum FileAssetVersionStatus {
  ACTIVE
  SUPERSEDED
  ARCHIVED
  LEGAL_HOLD
}

enum ReportJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum ReportOutputFormat {
  PDF
  EXCEL
  CSV
}

enum ReportScheduleFrequency {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
}

enum EnrollmentStatus {
  PENDING
  VALIDATED
  REJECTED
  COMPLETED
  ARCHIVED
}

/// Vue CRM formations catalogue (hors Enrollment LMS cours).
enum CandidatureStatus {
  /// Dossier en saisie, pièces incomplètes possibles.
  DRAFT
  /// Envoyé aux services / prêt pour instruction.
  SUBMITTED
  /// Retour instructeur pièces manquantes ou invalides.
  MISSING_DOCUMENTS
  VALIDATION_PENDING
  PENDING_CNAPS
  CNAPS_APPROVED
  CNAPS_REJECTED
  /// Dossier administratif conforme : apte à être placé sur une session.
  VALIDATED
  /// Formation suivie, examen réussi et attestation délivrée.
  COMPLETED
  REJECTED
  ARCHIVED
}

enum FormationExamOutcome {
  PENDING
  PASSED
  FAILED
  ABSENT
}

enum FormationExamStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum CandidatureSource {
  MANUAL
  LEAD
  LANDING_SESSION
}

enum FormationSessionEnrollmentStatus {
  CONFIRMED
  WAITLIST
  CANCELLED
}

/// Créneau journalier suivi formation (émargement matin / soir).
enum FormationSessionDaySlot {
  MORNING
  EVENING
}

enum FormationSessionEmargementStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

/// WF-18 — cycle de justification d'absence (uniquement si status = ABSENT).
enum AbsenceJustificationStatus {
  UNJUSTIFIED
  JUSTIFICATION_REQUESTED
  JUSTIFIED
  RESOLVED
}

/// WF-08 — cycle convention/contrat de formation (par participant).
enum SessionConventionStatus {
  GENERATED
  SENT
  VIEWED
  SIGNED
  ARCHIVED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  EXCUSED
}

enum UserBusinessLabel {
  COLLABORATEUR
  FORMATEUR
}

/// Service / équipe interne à l’école de formation (pas une entité juridique ni une « unité » multi-tenant GSMS).
enum SchoolInternalService {
  /// Pool formateurs et intervenants.
  TRAINER_POOL
  /// Coordination pédagogique, programmes, qualité.
  PEDAGOGICAL
  /// RH, administration, support.
  HR_ADMIN
  /// Direction de l'établissement (gérant, directeur, équipe de pilotage).
  DIRECTION
}

enum EquipmentStatus {
  AVAILABLE
  IN_USE
  MAINTENANCE
  OUT_OF_SERVICE
}

enum EquipmentMaintenanceStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  OVERDUE
}

enum StockMovementType {
  IN
  OUT
  TRANSFER
}

model LandingConfig {
  id String @id @default(uuid())

  sections Json    @default("[]") // Stocke les sections dynamiques (Hero, Sheets, etc.)
  enabled  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id       String     @id @default(uuid())
  email    String     @unique
  password String?
  country  String?
  timezone String?
  name     String?
  roleId   String
  status   UserStatus @default(INACTIVE)

  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt
  lastSignInAt            DateTime?
  emailVerifiedAt         DateTime?
  isTrashed               Boolean       @default(false)
  avatar                  String?
  firstName               String?
  lastName                String?
  phone                   String?
  proEmail                String?       @unique
  userCategory            UserCategory  @default(INTERNAL)
  subcontractorId         String?
  jobFunction             String?
  jobPositionId           String?
  qualification           String?
  birthDate               DateTime?
  birthPlace              String?
  nationality             String?
  socialSecurityNumber    String?
  cniNumber               String?
  residencePermitNumber   String?
  residencePermitExpiry   DateTime?
  contractType            ContractType?
  workTimeType            WorkTimeType?
  contractStartDate       DateTime?
  contractEndDate         DateTime?
  address                 String?
  city                    String?
  postalCode              String?
  carteProNumber          String?
  carteProExpiry          DateTime?
  isSchedulable           Boolean       @default(true)
  /// Présentation courte affichée sur le landing (#trainers) et fiches publiques équipe.
  landingPresentation     String?       @db.Text
  documentCni             String?
  documentAssurance       String?
  documentResidencePermit String?
  documentCartePro        String?
  invitedByUserId         String?
  isProtected             Boolean       @default(false)

  role        UserRole    @relation(fields: [roleId], references: [id])
  jobPosition RhPosition? @relation(fields: [jobPositionId], references: [id], onDelete: SetNull)
  systemLog   SystemLog[]
  accounts    Account[]
  Session     Session[]

  // LMS relations
  courses                  Course[]
  userProgress             UserProgress[]
  purchases                Purchase[]
  stripeCustomer           StripeCustomer?
  activitiesModified       Activity[]         @relation("ActivityModifier")
  chaptersReviewed         Chapter[]          @relation("ChapterReviewer")
  activitiesReviewed       Activity[]         @relation("ActivityReviewer")
  quizQuestionBanksCreated QuizQuestionBank[] @relation("QuizBankCreator")

  instructorSessions TrainingSession[]      @relation("Instructor")
  enrollments        Enrollment[]
  attendances        Attendance[]
  grades             Grade[]
  submissions        AssignmentSubmission[]
  quizAttempts       QuizAttempt[]

  formationSessionParticipants      FormationSessionParticipant[]
  formationSessionEmargementsMarked FormationSessionEmargement[]  @relation("FormationSessionEmargementMarkedBy")
  formationAttestations             FormationAttestation[]
  candidatures                      Candidature[]
  complianceDossiers                ComplianceDossier[]           @relation("ComplianceDossierUser")
  complianceItemsValidated          ComplianceDossierItem[]       @relation("ComplianceItemValidator")
  fundingCasesAsLearner             FundingCase[]                 @relation("FundingCaseLearner")
  evidenceAsLearner                 Evidence[]                    @relation("EvidenceLearner")
  evidenceAsTrainer                 Evidence[]                    @relation("EvidenceTrainer")
  documentRequestsRequested         DocumentRequest[]             @relation("DocumentRequestRequester")
  complianceEventsActed             ComplianceItemEvent[]         @relation("ComplianceEventActor")
  /**
   * Sessions formation CRM dont cet utilisateur est le formateur référent.
   */
  formationSessionsTrained          FormationSession[]            @relation("FormationSessionTrainer")
  /**
   * Sessions dont cet utilisateur modère le chat pédagogique.
   */
  formationSessionsModerated        FormationSession[]            @relation("FormationSessionModerator")

  certificates    UserCertificate[]
  discussions     Discussion[]
  comments        Comment[]
  discussionVotes DiscussionVote[]
  commentVotes    CommentVote[]

  trails                   Trail[]
  trailRuns                TrailRun[]
  apiTokens                ApiToken[]
  webhooks                 WebhookEndpoint[]
  businessRoles            UserBusinessRole[]
  collaborateurProfile     CollaborateurProfile?
  formateurProfile         FormateurProfile?
  landingTeamOffer         LandingTeamOffer?
  managedCollaborateurs    CollaborateurProfile[]      @relation("CollaborateurManager")
  createdFileAssets        FileAsset[]                 @relation("FileAssetCreatedBy")
  createdFileAssetVersions FileAssetVersion[]          @relation("FileAssetVersionCreatedBy")
  requestedReportJobs      ReportGenerationJob[]       @relation("ReportJobsRequested")
  requestedAiRuns          AiRun[]                     @relation("AiRunsRequested")
  reviewedAiArtifacts      AiArtifact[]                @relation("AiArtifactReviewed")
  assignedSupportTickets   SupportTicket[]             @relation("SupportTicketAssignee")
  createdSupportTickets    SupportTicket[]             @relation("SupportTicketCreatedBy")
  ticketComments           TicketComment[]             @relation("TicketCommentAuthor")
  ticketAttachments        TicketAttachment[]          @relation("TicketAttachmentUploader")
  helpArticlesAuthored     HelpArticle[]               @relation("HelpArticleAuthor")
  assignedQualityIncidents QualityIncident[]           @relation("QualityIncidentAssignee")
  reportedQualityIncidents QualityIncident[]           @relation("QualityIncidentReporter")
  notificationPreference   UserNotificationPreference?

  inAppNotifications      InAppNotification[]
  chatParticipants        ChatParticipant[]
  chatMessages            ChatMessage[]
  chatInvitationsReceived ChatInvitation[]    @relation("ChatInvitationInvitee")
  chatInvitationsSent     ChatInvitation[]    @relation("ChatInvitationInviter")

  rhTeamsLed                 RhTeam[]           @relation("RhTeamLeader")
  rhTeamMemberships          RhTeamMember[]
  rhOrgUnitsManaged          RhOrgUnit[]        @relation("RhOrgUnitManager")
  rhAbsences                 RhAbsence[]
  rhAbsencesValidated        RhAbsence[]        @relation("RhAbsenceValidatedBy")
  venueRoomBookingsOrganized VenueRoomBooking[] @relation("VenueRoomBookingOrganizer")

  @@index([invitedByUserId])
  @@index([roleId])
  @@index([jobPositionId])
  @@index([status])
}

model FileAsset {
  id               String              @id @default(uuid())
  module           String
  entityType       String
  entityId         String?
  category         String?
  originalName     String
  mimeType         String
  size             Int
  issuedAt         DateTime?
  expiresAt        DateTime?
  issuedBy         String?
  documentRef      String?
  storageKey       String              @unique
  url              String
  visibility       FileAssetVisibility @default(PRIVATE)
  status           FileAssetStatus     @default(ACTIVE)
  provider         String              @default("s3")
  metadata         Json?               @default("{}")
  createdById      String?
  currentVersionId String?             @unique
  archivedAt       DateTime?
  archiveReason    String?
  legalHold        Boolean             @default(false)
  retentionUntil   DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  deletedAt        DateTime?

  createdBy              User?                        @relation("FileAssetCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  currentVersion         FileAssetVersion?            @relation("FileAssetCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  versions               FileAssetVersion[]           @relation("FileAssetVersions")
  reportJobs             ReportGenerationJob[]
  complianceDossierItems ComplianceDossierItem[]
  complianceItemEvents   ComplianceItemEvent[]
  ticketAttachments      TicketAttachment[]
  sessionConventions     FormationSessionConvention[]

  @@index([module, entityType, entityId])
  @@index([status, visibility])
  @@index([createdById])
  @@index([archivedAt])
}

model FileAssetVersion {
  id            String                 @id @default(uuid())
  fileAssetId   String
  versionNumber Int
  storageKey    String                 @unique
  url           String
  mimeType      String
  size          Int
  checksum      String?
  changeReason  String?
  status        FileAssetVersionStatus @default(ACTIVE)
  createdById   String?
  createdAt     DateTime               @default(now())

  fileAsset  FileAsset  @relation("FileAssetVersions", fields: [fileAssetId], references: [id], onDelete: Cascade)
  currentFor FileAsset? @relation("FileAssetCurrentVersion")
  createdBy  User?      @relation("FileAssetVersionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([fileAssetId, versionNumber])
  @@index([fileAssetId, status])
}

/// Job asynchrone de génération document (PDF / Excel / CSV) — traité par @repo/workers.
model ReportGenerationJob {
  id            String             @id @default(uuid())
  templateKey   String
  format        ReportOutputFormat
  period        String
  periodStart   DateTime
  periodEnd     DateTime
  periodLabel   String
  title         String
  summary       String?
  status        ReportJobStatus    @default(PENDING)
  progress      Int                @default(0)
  errorMessage  String?
  renderToken   String             @unique @default(uuid())
  parameters    Json               @default("{}")
  fileAssetId   String?
  requestedById String
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  completedAt   DateTime?

  requestedBy User       @relation("ReportJobsRequested", fields: [requestedById], references: [id])
  fileAsset   FileAsset? @relation(fields: [fileAssetId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([requestedById])
  @@index([templateKey])
}

enum AiRunStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

enum AiArtifactStatus {
  PROPOSED
  APPROVED
  APPLIED
  REJECTED
}

/// Exécution d'une tâche IA (génération de programme, déroulé, preuves Qualiopi...).
/// Le modèle ne touche jamais la base directement : il produit un ou plusieurs
/// AiArtifact que la fonction déterministe `apply*` correspondante valide et applique
/// après revue humaine — jamais d'écriture directe par le LLM (GSMS-AI-01).
model AiRun {
  id               String      @id @default(uuid())
  useCase          String
  status           AiRunStatus @default(PENDING)
  provider         String
  model            String
  inputSummary     Json        @default("{}")
  promptTokens     Int?
  completionTokens Int?
  costCents        Int?
  errorMessage     String?
  requestedById    String
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  completedAt      DateTime?

  requestedBy User         @relation("AiRunsRequested", fields: [requestedById], references: [id])
  artifacts   AiArtifact[]

  @@index([status, createdAt])
  @@index([useCase])
  @@index([requestedById])
}

/// Sortie structurée proposée par un AiRun. Reste à l'état PROPOSED tant qu'un humain
/// ne l'a pas revue (reviewedById/reviewedAt) ; l'application effective (appliedAt) est
/// faite par du code déterministe, jamais par le modèle lui-même.
model AiArtifact {
  id               String           @id @default(uuid())
  runId            String
  status           AiArtifactStatus @default(PROPOSED)
  payload          Json
  citations        Json             @default("[]")
  targetEntityType String?
  targetEntityId   String?
  reviewedById     String?
  reviewedAt       DateTime?
  appliedAt        DateTime?
  createdAt        DateTime         @default(now())

  run        AiRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("AiArtifactReviewed", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([runId])
  @@index([status])
  @@index([targetEntityType, targetEntityId])
}

enum AgentMessageRole {
  USER
  ASSISTANT
}

/// Fil de discussion agent attaché à un enregistrement (ex. un FundingCase). Une
/// conversation par entité. La transcription seule vit ici — toute proposition
/// d'écriture faite pendant la conversation reste un AiRun/AiArtifact séparé
/// (GSMS-AI-01) : ce modèle ne porte aucun statut ni cycle de vie.
model AgentConversation {
  id               String   @id @default(uuid())
  targetEntityType String
  targetEntityId   String
  createdAt        DateTime @default(now())

  messages AgentMessage[]

  @@unique([targetEntityType, targetEntityId])
}

model AgentMessage {
  id             String           @id @default(uuid())
  conversationId String
  role           AgentMessageRole
  content        String
  createdAt      DateTime         @default(now())

  conversation AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

/// Planification automatique des rapports (quotidien, mensuel, trimestriel).
model ReportGenerationSchedule {
  id          String                  @id @default(uuid())
  templateKey String
  format      ReportOutputFormat      @default(PDF)
  frequency   ReportScheduleFrequency
  title       String
  summary     String?
  parameters  Json                    @default("{}")
  enabled     Boolean                 @default(true)
  lastRunAt   DateTime?
  nextRunAt   DateTime?
  createdById String?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  @@index([enabled, nextRunAt])
  @@index([frequency])
}

model UserBusinessRole {
  id        String            @id @default(uuid())
  userId    String
  label     UserBusinessLabel
  isPrimary Boolean           @default(false)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, label])
  @@index([label])
  @@index([userId, isPrimary])
}

model CollaborateurProfile {
  id                    String                 @id @default(uuid())
  userId                String                 @unique
  employeeCode          String?                @unique
  companyId             String?
  schoolInternalService SchoolInternalService?
  managerUserId         String?
  hireDate              DateTime?
  endDate               DateTime?
  contractType          String?
  workTimeType          String?
  qualification         String?
  jobFunction           String?
  carteProNumber        String?
  carteProExpiry        DateTime?
  socialSecurityNumber  String?
  cniNumber             String?
  residencePermitNumber String?
  residencePermitExpiry DateTime?
  birthDate             DateTime?
  birthPlace            String?
  nationality           String?
  address               String?
  city                  String?
  postalCode            String?
  country               String?
  isSchedulable         Boolean                @default(true)
  metadata              Json?                  @default("{}")
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  user    User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  manager User? @relation("CollaborateurManager", fields: [managerUserId], references: [id], onDelete: SetNull)

