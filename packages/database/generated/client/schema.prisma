// ─── Enquête satisfaction stagiaire (GSMS-OF-10) ──────────────────────────────

enum SatisfactionSurveyTiming {
  HOT
  COLD
  /// WF-28 — commanditaire / entreprise
  COMPANY
  /// WF-29 — formateur de la session
  TRAINER
  /// WF-30 — financeur (OPCO, FT, etc.)
  FUNDER
}

enum SatisfactionSurveyStatus {
  PENDING
  SENT
  COMPLETED
  EXPIRED
}

/// Enquête de satisfaction — HOT/COLD par participant ; COMPANY/TRAINER/FUNDER
/// une ligne par session (audienceKey fixe). Réponses en JSON libre.
model SatisfactionSurvey {
  id             String                   @id @default(uuid())
  sessionId      String
  /// Renseigné pour HOT/COLD ; null pour COMPANY/TRAINER/FUNDER.
  participantId  String?
  /// Clé d'unicité : participantId (HOT/COLD) ou "COMPANY"|"TRAINER"|"FUNDER".
  audienceKey    String
  timing         SatisfactionSurveyTiming
  status         SatisfactionSurveyStatus @default(PENDING)
  sentAt         DateTime?
  respondedAt    DateTime?
  answers        Json?
  /// Destinataire stakeholder (COMPANY/TRAINER/FUNDER) ou copie e-mail stagiaire.
  recipientEmail String?
  recipientName  String?
  /// Score moyen 1–4 calculé à la clôture (WF-32) ; null si pas de questions scale.
  scoreAverage   Float?
  /// true si score < seuil (alerte Qualiopi / Evidence LOG).
  scoreAlert     Boolean                  @default(false)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  session     FormationSession             @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  participant FormationSessionParticipant? @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([sessionId, timing, audienceKey])
  @@index([sessionId])
  @@index([status])
  @@index([scoreAlert])
}

