  @@unique([kind, subjectType, subjectId])
  @@index([userId])
  @@index([candidatureId])
  @@index([status])
  @@index([kind])
}

model ComplianceDossierItem {
  id                 String               @id @default(uuid())
  dossierId          String
  templateItemId     String?
  code               String
  label              String
  fileCategory       String
  required           Boolean              @default(true)
  uploadedBy         ComplianceUploader   @default(SUBJECT)
  status             ComplianceItemStatus @default(MISSING)
  fileAssetId        String?
  fileAssetVersionId String?
  expiresAt          DateTime?
  validatedAt        DateTime?
  validatedById      String?
  rejectionReason    String?              @db.Text
  lastCheckedAt      DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  dossier      ComplianceDossier                @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  templateItem DocumentRequirementTemplateItem? @relation(fields: [templateItemId], references: [id], onDelete: SetNull)
  fileAsset    FileAsset?                       @relation(fields: [fileAssetId], references: [id], onDelete: SetNull)
  validatedBy  User?                            @relation("ComplianceItemValidator", fields: [validatedById], references: [id], onDelete: SetNull)
  requests     DocumentRequest[]
  events       ComplianceItemEvent[]

  @@unique([dossierId, code])
  @@index([dossierId, status])
  @@index([fileAssetId])
}

model DocumentRequest {
