enum RhOrgUnitType {
  DIRECTION
  SERVICE
  POLE
  CAMPUS
}

enum RhTeamType {
  PEDAGOGICAL
  TRAINER_POOL
  HR_ADMIN
  DIRECTION
  QUALITY
  ADMIN
}

enum RhTeamSector {
  HEADQUARTERS
  CAMPUS
  EXTERNAL
}

/// Cycle de vie d'une équipe liée à une session catalogue.
enum RhTeamLifecycleStatus {
  ACTIVE
  POST_EXAM
  ARCHIVED
}

/// Unité organisationnelle RH (direction, pôle, campus…)
model RhOrgUnit {
  id         String        @id @default(uuid())
  name       String
  type       RhOrgUnitType @default(SERVICE)
  parentId   String?
  managerId  String?
  positionId String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  parent   RhOrgUnit?  @relation("RhOrgUnitTree", fields: [parentId], references: [id], onDelete: SetNull)
  children RhOrgUnit[] @relation("RhOrgUnitTree")
  manager  User?       @relation("RhOrgUnitManager", fields: [managerId], references: [id], onDelete: SetNull)
  position RhPosition? @relation(fields: [positionId], references: [id], onDelete: SetNull)
  teams    RhTeam[]

  @@index([parentId])
  @@index([managerId])
  @@index([positionId])
}

/// Équipe opérationnelle RH (pôles pédagogiques, formateurs, qualité…)
model RhTeam {
  id                 String                @id @default(uuid())
  name               String
  description        String?
  type               RhTeamType            @default(PEDAGOGICAL)
  sector             RhTeamSector          @default(CAMPUS)
  image              String?
  siteId             String?
  orgUnitId          String?
  leaderId           String?
  /// Équipe auto-provisionnée pour une session formation (1:1).
  formationSessionId String?               @unique
  lifecycleStatus    RhTeamLifecycleStatus @default(ACTIVE)
  lifecycleClosedAt  DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  site              ClientSite?        @relation(fields: [siteId], references: [id], onDelete: SetNull)
  orgUnit           RhOrgUnit?         @relation(fields: [orgUnitId], references: [id], onDelete: SetNull)
  leader            User?              @relation("RhTeamLeader", fields: [leaderId], references: [id], onDelete: SetNull)
  formationSession  FormationSession?  @relation(fields: [formationSessionId], references: [id], onDelete: SetNull)
  members           RhTeamMember[]
  chatConversations ChatConversation[]

  @@index([siteId])
  @@index([orgUnitId])
  @@index([leaderId])
  @@index([name])
  @@index([lifecycleStatus])
}

model RhTeamMember {
  id        String   @id @default(uuid())
  teamId    String
  userId    String
  createdAt DateTime @default(now())

  team RhTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
}

enum RhAbsenceType {
  CONGE_PAYE
  MALADIE
  RTT
  AUTRE
}

enum RhAbsenceStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Demande d'absence / congé collaborateur
model RhAbsence {
  id            String          @id @default(uuid())
  userId        String
  type          RhAbsenceType
  status        RhAbsenceStatus @default(PENDING)
  startDate     DateTime        @db.Date
  endDate       DateTime        @db.Date
  reason        String?         @db.Text
  validatedById String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  user        User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  validatedBy User? @relation("RhAbsenceValidatedBy", fields: [validatedById], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@index([startDate])
}

/// Référentiel postes / fonctions métier école
model RhPosition {
  id                    String                 @id @default(uuid())
  label                 String
  code                  String?                @unique
  schoolInternalService SchoolInternalService?
  sortOrder             Int                    @default(0)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  users    User[]
  orgUnits RhOrgUnit[]

  @@index([sortOrder])
  @@index([schoolInternalService, sortOrder])
}

/// Référentiel qualifications par pôle interne (CFA).
model RhQualification {
  id                    String                @id @default(uuid())
  label                 String
  code                  String                @unique
  schoolInternalService SchoolInternalService
  sortOrder             Int                   @default(0)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  @@index([schoolInternalService, sortOrder])
}

model Equipment {
  id                  String                   @id @default(uuid())
  serialNumber        String                   @unique
  label               String
  type                String?
  status              EquipmentStatus          @default(AVAILABLE)
  assignedSiteId      String?
  assignedSite        ClientSite?              @relation(fields: [assignedSiteId], references: [id], onDelete: SetNull)
  metadata            Json?                    @default("{}")
  avatar              String?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  maintenanceItems    EquipmentMaintenance[]
  stockMovements      StockMovement[]
  sessions            TrainingSession[]
  roomFixedAssignment VenueRoomFixedEquipment?
  qualityIncidents    QualityIncident[]

  @@index([status])
  @@index([type])
  @@index([assignedSiteId])
}

model EquipmentMaintenance {
  id            String                     @id @default(uuid())
  equipmentId   String
  status        EquipmentMaintenanceStatus @default(SCHEDULED)
  title         String?
  notes         String?
  scheduledDate DateTime?
  completedDate DateTime?
  /// Coût intervention / pièces (€) — charge budget EQUIPEMENT.
  costAmount    Decimal?                   @db.Decimal(12, 2)
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt
  equipment     Equipment                  @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@index([equipmentId])
  @@index([status])
  @@index([scheduledDate])
}

model StockMovement {
  id           String            @id @default(uuid())
  equipmentId  String
  type         StockMovementType
  quantity     Int
  movementDate DateTime          @default(now())
  notes        String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  equipment    Equipment         @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@index([equipmentId])
  @@index([type])
  @@index([movementDate])
}

// --- CRM: catalogue formations (fiches vitrine + sessions commerciales ; aligné sheets Formations CRM / landing) ---
// Distinct du LMS `TrainingSession` (instances liées à `Course`).

enum FormationLifecycleStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum FormationTrack {
  surete
  incendie
  habilitation
  sst
  entreprise
  autres
}

enum FormationParcoursSpecialite {
  INITIAL
  MAC
  RAN
  AUTRE
}

enum FormationDeliveryMode {
  PRESENTIEL
  DISTANCIEL
  MIXTE
  ENTREPRISE_SUR_SITE
}

/// Sessions vitrine CRM. `sessionKind` est **dérivé du parcours** de la formation :
/// parcours Initial â `WITH_EXAM` (examen en fin de parcours) ; MAC / RAN / Autre â `INITIAL`.
/// Valeur `OTHER` réservée aux cas exceptionnels. Le CRM ne propose pas un interrupteur « avec/sans examen » séparé.
enum FormationVitrineSessionKind {
  INITIAL
  WITH_EXAM
  OTHER
}

model Formation {
  id          String  @id @default(uuid())
  slug        String  @unique
  name        String
  /// Résumé carte liste / SEO (catalogue vitrine).
  description String? @db.Text

  track              FormationTrack
  tag                String
  duration           String                      @db.Text
  parcoursSpecialite FormationParcoursSpecialite @default(INITIAL)

  status   FormationLifecycleStatus @default(DRAFT)
  featured Boolean                  @default(false)

  /// Sidebar : logo formation (URL ou clé média).
  logoUrl          String? @db.Text
  providerName     String?
  providerEmail    String?
  providerPhone    String?
  providerAddress  String? @db.Text
  /// Libellé rapide type « Dès le 04 Mai 2026 » (sidebar upload).
  nextSessionLabel String?

  cpfEligible       Boolean @default(false)
  qualiopiCertified Boolean @default(false)
  rncpUrl           String? @db.Text
  rncpCode          String?

  deliveryMode FormationDeliveryMode?

  /// KPI vue d’ensemble (statistics1) — scalaires pour filtres / tri ; détails dans overviewMetrics si besoin.
  hoursMin               Int?
  hoursMax               Int?
  traineesMin            Int?
  traineesMax            Int?
  priceFrom              Decimal? @db.Decimal(10, 2)
  currency               String   @default("EUR")
  successRate            Decimal? @db.Decimal(5, 2)
  clientSatisfactionRate Decimal? @db.Decimal(5, 2)

  /// Bandeau Programme (statistics2).
  unitsCount       Int?
  volumeHoursLabel String?
  theoryPercent    Int?
  practicePercent  Int?

  /// Bandeau Prérequis (statistics4).
  minAgeLabel               String?
  frenchLevel               String?
  authorizationSummary      String?
  criminalRecordRequirement String?

  /// Carte « Présentation » (resent-order).
  presentationTitle String?
  longDescription   String? @db.Text

  /// listes / tableaux riches (structure libre, consommée par les sheets CRM).
  modules              Json @default("[]")
  outcomes             Json @default("[]")
  presentationBullets  Json @default("[]")
  programModules       Json @default("[]")
  prerequisitesTable   Json @default("[]")
  fundingBlocks        Json @default("[]")
  fundingChannels      Json @default("[]")
  overviewMetrics      Json @default("[]")
  certificationSteps   Json @default("[]")
  /// Résumés carte « Détails complémentaires » + métadonnées UI (axes, version commerciale…).
  complementaryDetails Json @default("{}")

  /// Routage type sheet landing (`FORMATION_CATALOG_PROGRAM_BY_SLUG`) sérialisé en JSON.
  catalogProgramConfig Json @default("{}")

  /// Pont optionnel vers un cours LMS (sync progression / TrainingSession).
  courseId String? @unique
  course   Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)

  sessions            FormationSession[]
  portalAnnouncements PortalSessionAnnouncement[]
  quizQuestionBanks   QuizQuestionBank[]

  /// Offre catalogue CRM
  catalogOffer FormationCatalogOffer?

  /// Ligne catalogue finance (prestations / tarifs devis), synchronisée depuis l’offre catalogue.
  financeCatalogLine FinanceCatalogLine?

  candidatures     Candidature[]
  attestations     FormationAttestation[]
  /// Demandes de devis landing (Lead.source = Landing demande de devis).
  quoteLeads       Lead[]                 @relation("LeadQuoteFormation")
  financeDevis     FinanceDevis[]
  trainingRequests TrainingRequest[]
  evidences        Evidence[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([track])
  @@index([parcoursSpecialite])
  @@index([featured])
}

/// Inclusion d'une fiche référence dans le catalogue école — pas de duplication métier, surcharges optionnelles.
model FormationCatalogOffer {
  id          String    @id @default(uuid())
  formationId String    @unique
  formation   Formation @relation(fields: [formationId], references: [id], onDelete: Cascade)

  /// Visible catalogue / brouillon / suspendu (archivé). La ligne référence `Formation` n'est jamais supprimée.
  catalogStatus FormationLifecycleStatus @default(ACTIVE)

  priceFromOverride Decimal? @db.Decimal(10, 2)
  currencyOverride  String?

  /// Affichage catalogue : initial / MAC / RANâ¦ si null, reprend `Formation.parcoursSpecialite`.
  parcoursSpecialiteOverride FormationParcoursSpecialite?

  fundingBlocksOverride      Json?
  fundingChannelsOverride    Json?
  prerequisitesTableOverride Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([catalogStatus])
}

/// Volet affiché sur la section #trainers du landing.
enum LandingTeamVolet {
  direction
  formateur
  pedagogique
  rh
}

/// Membre de l'équipe publiée sur le landing (#trainers) — lié à un compte RH / formateur.
model LandingTeamOffer {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  volet LandingTeamVolet

  catalogStatus FormationLifecycleStatus @default(ACTIVE)

  sortOrder Int @default(0)

  titleOverride               String?
  certificationsLabelOverride String? @db.Text
  bioOverride                 String? @db.Text
  statAOverride               Int?
  statBOverride               Int?
  ratingOverride              Float?
  linkedinUrl                 String?
  websiteUrl                  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([catalogStatus, volet, sortOrder])
}

/// Salle ou espace pédagogique réservable pour les sessions catalogue CRM (libellés métier : « Salle Aurore », etc.).
model FormationVenueRoom {
  id             String                    @id @default(uuid())
  name           String
  shortCode      String?                   @unique
  capacity       Int?
  floorLabel     String?
  /// Visuel vitrine (URL relative Next `/media/...`).
  imageUrl       String?
  isActive       Boolean                   @default(true)
  sortOrder      Int                       @default(0)
  sessions       FormationSession[]
  examSessions   FormationSession[]        @relation("FormationSessionExamRoom")
  formationExams FormationExam[]           @relation("FormationExamVenueRoom")
  bookings       VenueRoomBooking[]
  fixedEquipment VenueRoomFixedEquipment[]
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  @@index([isActive])
  @@index([sortOrder])
}

/// Mobilier / matériel permanent installé dans une salle (chaises, vidéoprojecteur…).
/// Distinct des `FormationSession.reservedEquipmentIds` (réservation ponctuelle session).
model VenueRoomFixedEquipment {
  id          String             @id @default(uuid())
  venueRoomId String
  venueRoom   FormationVenueRoom @relation(fields: [venueRoomId], references: [id], onDelete: Cascade)
  equipmentId String             @unique
  equipment   Equipment          @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  quantity    Int                @default(1)
  installedAt DateTime?
  notes       String?            @db.Text
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([venueRoomId])
}

enum VenueRoomBookingKind {
  STAFF_MEETING
  INFO_MEETING
  OTHER
}

enum VenueRoomBookingStatus {
  ACTIVE
  CANCELLED
}

/// Réservation ponctuelle de salle (réunion staff, réunion info, etc.) — hors session catalogue.
model VenueRoomBooking {
  id              String                 @id @default(uuid())
  venueRoomId     String
  venueRoom       FormationVenueRoom     @relation(fields: [venueRoomId], references: [id], onDelete: Cascade)
  title           String
  kind            VenueRoomBookingKind   @default(STAFF_MEETING)
  status          VenueRoomBookingStatus @default(ACTIVE)
  startAt         DateTime
  endAt           DateTime
  notes           String?                @db.Text
  organizerUserId String?
  organizer       User?                  @relation("VenueRoomBookingOrganizer", fields: [organizerUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@index([venueRoomId])
  @@index([startAt])
  @@index([endAt])
  @@index([status])
}

model FormationSession {
  id          String    @id @default(uuid())
  formationId String
  formation   Formation @relation(fields: [formationId], references: [id], onDelete: Cascade)

  startDate DateTime?
  endDate   DateTime?

  /// Clôture des inscriptions (horodatage).
  registrationClosesAt     DateTime?
  /// Date / heure d’examen prévue (optionnel).
  examDate                 DateTime?
  /// Salle d’examen (PCS, plateau incendie…) si différente de la salle de cours.
  examVenueRoomId          String?
  examVenueRoom            FormationVenueRoom? @relation("FormationSessionExamRoom", fields: [examVenueRoomId], references: [id], onDelete: SetNull)
  /// Matériel mobile réservé pour le jour d’examen (magnétomètre, fumigènes…).
  examReservedEquipmentIds Json                @default("[]")

  /// Effectif cible pour cette session (distinct de la fourchette « fiche formation »).
  traineesMin Int?
  traineesMax Int?

  /// Formateur référent (compte rôle formateur).
  trainerUserId String?
  trainer       User?   @relation("FormationSessionTrainer", fields: [trainerUserId], references: [id], onDelete: SetNull)

  /// Référent pédagogique modérateur du chat de session.
  moderatorUserId String?
  moderator       User?   @relation("FormationSessionModerator", fields: [moderatorUserId], references: [id], onDelete: SetNull)

  /// Groupe chat lié (formateur + élèves + modérateur) — relation inverse.
  chatConversation ChatConversation?

  /// Salle allouée (disponibilité = pas de autre session même salle sur dates qui se chevauchent).
  venueRoomId String?
  venueRoom   FormationVenueRoom? @relation(fields: [venueRoomId], references: [id], onDelete: SetNull)

  /// Identifiants `Equipment` réservés pour la session (JSON : tableau d’UUID).
  reservedEquipmentIds Json @default("[]")

  /// Libellé affiché (ex. « 04 Mai au 12 Juin 2026 ») tant que les dates ne sont pas renseignées partout.
  dateDisplayLabel String                      @db.Text
  location         String
  sessionKind      FormationVitrineSessionKind @default(INITIAL)

  /// SD-06 session readiness (WF-10)
  readinessStatus SessionReadinessStatus @default(DRAFT)

  venueBrandPrefix String? @db.Text
  sessionSubtitle  String?

  sortOrder      Int     @default(0)
  bookingEnabled Boolean @default(false)
  bookingUrl     String? @db.Text

  participants        FormationSessionParticipant[]
  suiviDays           FormationSessionDay[]
  attestations        FormationAttestation[]
  formationExam       FormationExam?
  portalAnnouncements PortalSessionAnnouncement[]
  rhTeam              RhTeam?
  satisfactionSurveys SatisfactionSurvey[]
  fundingCases        FundingCase[]
  evidences           Evidence[]
  readinessEvents     SessionReadinessEvent[]
  conventions         FormationSessionConvention[]

  candidaturesInterested   Candidature[]          @relation("CandidatureInterestedSession")
  financeDevisSessionLinks FinanceDevis[]         @relation("FinanceDevisLinkedSession")
  automationRuns           SessionAutomationRun[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([formationId])
  @@index([startDate])
  @@index([venueRoomId])
  @@index([examVenueRoomId])
  @@index([readinessStatus])
}

enum SessionAutomationStatus {
  RUNNING
  COMPLETED
  CANCELLED
  FAILED
}

/// Exécution circuit n8n (jalons J-15 → J+45) — suivi / annulation si session reportée.
model SessionAutomationRun {
  id             String                  @id @default(uuid())
  sessionId      String
  session        FormationSession        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  participantId  String?
  candidatureId  String?
  circuitKey     String                  @default("default")
  n8nExecutionId String?
  status         SessionAutomationStatus @default(RUNNING)
  milestones     Json                    @default("[]")
  metadata       Json                    @default("{}")
  startedAt      DateTime                @default(now())
  completedAt    DateTime?
  cancelledAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sessionId])
  @@index([status])
  @@index([n8nExecutionId])
}

/// Annonce portail candidat â cible une session ou toute la formation (sessionId null).
model PortalSessionAnnouncement {
  id          String            @id @default(uuid())
  formationId String
  formation   Formation         @relation(fields: [formationId], references: [id], onDelete: Cascade)
  sessionId   String?
  session     FormationSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  title       String
  content     String            @db.Text
  publishedAt DateTime          @default(now())
  isPublished Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([formationId])
  @@index([sessionId])
  @@index([publishedAt])
}

/// Dossier d’entrée CRM
model Candidature {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  formationId String?
  formation   Formation? @relation(fields: [formationId], references: [id], onDelete: SetNull)

  /// Session précise visée depuis le landing (optionnel ; doit appartenir à `formationId` lorsque les deux sont renseignés).
  interestedSessionId String?
  interestedSession   FormationSession? @relation("CandidatureInterestedSession", fields: [interestedSessionId], references: [id], onDelete: SetNull)

  leadId String? @unique
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)

  source CandidatureSource @default(MANUAL)
  status CandidatureStatus @default(DRAFT)

  cnapsSubmittedAt  DateTime?
  cnapsReference    String?
  cnapsDecisionAt   DateTime?
  /// Réponse PN/CNAPS lorsque suivie manuellement (null = encore en cours).
  cnapsPrefavorable Boolean?

  validatedAt DateTime?
  completedAt DateTime?
  archivedAt  DateTime?

  notes    String? @db.Text
  metadata Json    @default("{}")

  documentsCompleteAt DateTime?
  complianceDossiers  ComplianceDossier[]
  sessionEnrollments  FormationSessionParticipant[]
  attestations        FormationAttestation[]
  financeDevis        FinanceDevis[]
  assessments         CandidatureAssessment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([formationId])
  @@index([status])
  @@index([interestedSessionId])
}

/// WF-02 / WF-03 — analyse du besoin + positionnement (pattern SatisfactionSurvey).
enum CandidatureAssessmentKind {
  NEEDS_ANALYSIS
  POSITIONING
}

enum CandidatureAssessmentStatus {
  PENDING
  SENT
  COMPLETED
}

/// WF-04 — suivi accessibilité / aménagement côté candidature.
enum AdaptationStatus {
  NO_ADAPTATION_REQUIRED
  ADAPTATION_PENDING
  ADAPTATION_APPROVED
  ADAPTATION_IMPLEMENTED
}

model CandidatureAssessment {
  id                   String                      @id @default(uuid())
  candidatureId        String
  kind                 CandidatureAssessmentKind
  status               CandidatureAssessmentStatus @default(PENDING)
  sentAt               DateTime?
  completedAt          DateTime?
  /// Réponses questionnaire (Json libre).
  answers              Json?
  /// WF-03 — niveau constaté (libre).
  level                String?
  /// WF-03 — OK / PARTIAL / MISSING (ou texte libre).
  prerequisitesStatus  String?
  /// Signal adaptation (lien WF-04 organisme, info staff).
  adaptationRequired   Boolean?
  /// WF-04 — cycle aménagement (renseigné surtout sur NEEDS_ANALYSIS).
  adaptationStatus     AdaptationStatus?
  adaptationNotifiedAt DateTime?
  adaptationNotes      String?                     @db.Text

  candidature Candidature @relation(fields: [candidatureId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([candidatureId, kind])
  @@index([candidatureId])
  @@index([status])
  @@index([adaptationRequired])
  @@index([adaptationStatus])
}

/// Participation à une session vitrine CRM. `candidatureId` rattache au dossier validé lorsqu’existant.
model FormationSessionParticipant {
  id        String           @id @default(uuid())
  sessionId String
  session   FormationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  candidatureId String?
  candidature   Candidature? @relation(fields: [candidatureId], references: [id], onDelete: SetNull)

  enrollmentStatus FormationSessionEnrollmentStatus @default(CONFIRMED)

  examOutcome         FormationExamOutcome @default(PENDING)
  examDate            DateTime?
  certifiedAt         DateTime?
  trainingCompletedAt DateTime?

  /// Financeur / modalité de prise en charge (CPF, France Travail, OPCO…).
  fundingMode      String?
  fundingReference String?
  fundingNotes     String? @db.Text

  /// WF-14 — rappel J-5 préparation pédagogique déjà envoyé.
  j5PrepReminderSentAt DateTime?

  /// WF-24 — date de rattrapage proposée (si examOutcome = FAILED).
  retakeDate  DateTime?
  retakeNotes String?   @db.Text

  emargements         FormationSessionEmargement[]
  satisfactionSurveys SatisfactionSurvey[]
  fundingCases        FundingCase[]
  conventions         FormationSessionConvention[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sessionId, userId])
  @@index([userId])
  @@index([j5PrepReminderSentAt])
  @@index([retakeDate])
  @@index([candidatureId])
  @@index([examOutcome])
}

/// Jour de formation dans le suivi quotidien CRM (dates dérivées de la session ou ajout manuel).
model FormationSessionDay {
  id        String           @id @default(uuid())
  sessionId String
  session   FormationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  dayDate DateTime @db.Date

  journalNotesMorning String? @db.Text
  journalNotesEvening String? @db.Text

  attendances FormationSessionEmargement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sessionId, dayDate])
  @@index([sessionId])
}

/// Émargement nominatif par stagiaire et créneau (matin / soir).
model FormationSessionEmargement {
  id            String                      @id @default(uuid())
  dayId         String
  day           FormationSessionDay         @relation(fields: [dayId], references: [id], onDelete: Cascade)
  participantId String
  participant   FormationSessionParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  slot   FormationSessionDaySlot
  status FormationSessionEmargementStatus @default(PRESENT)

  markedAt       DateTime?
  markedByUserId String?
  markedBy       User?     @relation("FormationSessionEmargementMarkedBy", fields: [markedByUserId], references: [id], onDelete: SetNull)
  notes          String?   @db.Text

  /// WF-18 — null sauf si status = ABSENT.
  justificationStatus      AbsenceJustificationStatus?
  justificationRequestedAt DateTime?
  justificationNote        String?                     @db.Text
  justificationResolvedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([dayId, participantId, slot])
  @@index([participantId])
  @@index([dayId])
  @@index([justificationStatus])
}

/// WF-08 — convention de formation par participant (cycle GENERATED→…→ARCHIVED).
model FormationSessionConvention {
  id             String                  @id @default(uuid())
  sessionId      String
  participantId  String
  status         SessionConventionStatus @default(GENERATED)
  fileAssetId    String?
  /// Token signé optionnel pour ouverture publique (VIEWED).
  publicToken    String?                 @unique
  sentAt         DateTime?
  viewedAt       DateTime?
  signedAt       DateTime?
  lastReminderAt DateTime?
  reminderCount  Int                     @default(0)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  session     FormationSession            @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  participant FormationSessionParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  fileAsset   FileAsset?                  @relation(fields: [fileAssetId], references: [id], onDelete: SetNull)

  @@unique([sessionId, participantId])
  @@index([sessionId])
  @@index([status])
  @@index([sentAt])
}

/// Examen catalogue lié à une session `WITH_EXAM` (1:1).
model FormationExam {
  id        String           @id @default(uuid())
  sessionId String           @unique
  session   FormationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  scheduledAt DateTime?
  venueRoomId String?
  venueRoom   FormationVenueRoom? @relation("FormationExamVenueRoom", fields: [venueRoomId], references: [id], onDelete: SetNull)

  status FormationExamStatus @default(PLANNED)

  juryPresidentName String?
  examinerName      String?
  /// Membres du jury (JSON string[]).
  juryMemberNames   Json    @default("[]")
  notes             String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([scheduledAt])
  @@index([status])
  @@index([venueRoomId])
}

/// Attestation / certification délivrée après parcours catalogue CRM (distinct du LMS `UserCertificate`).
model FormationAttestation {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  candidatureId String?
  candidature   Candidature? @relation(fields: [candidatureId], references: [id], onDelete: SetNull)

  formationId String
  formation   Formation @relation(fields: [formationId], references: [id], onDelete: Cascade)

  sessionId String?
  session   FormationSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  title          String
  certificateUrl String?   @db.Text
  issueDate      DateTime  @default(now())
  expiryDate     DateTime?
  metadata       Json      @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([candidatureId])
  @@index([formationId])
  @@index([sessionId])
}

// LMS Models
model Course {
  id          String  @id @default(uuid())
  createdById String
  title       String  @db.Text
  description String? @db.Text
  imageUrl    String? @db.Text
  price       Float?
  isPublished Boolean @default(false)

  attachments Attachment[]
  category    Category?    @relation(fields: [categoryId], references: [id])
  categoryId  String?
  chapters    Chapter[]
  purchases   Purchase[]
  createdBy   User         @relation(fields: [createdById], references: [id], onDelete: Cascade)

  trainingSessions TrainingSession[]
  enrollments      Enrollment[]
  grades           Grade[]

  certifications Certification[]
  community      Community?
  embeddings     CourseEmbedding[]
  collections    Collection[]      @relation("CourseToCollection")
  leads          Lead[]
  trailSteps     TrailStep[]

  formationCatalog  Formation?
  quizQuestionBanks QuizQuestionBank[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([createdById])
}

model Category {
  id      String   @id @default(uuid())
  name    String   @unique
  courses Course[]
}

model Attachment {
  id   String @id @default(uuid())
  name String
  url  String @db.Text

  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseId])
}

model Chapter {
  id          String  @id @default(uuid())
  title       String
  description String? @db.Text
  videoUrl    String? @db.Text
  position    Int
  isPublished Boolean @default(false)
  isFree      Boolean @default(false)

  reviewStatus         LmsContentReviewStatus @default(APPROVED)
  submittedForReviewAt DateTime?
  reviewedAt           DateTime?
  reviewNote           String?                @db.Text
  reviewedById         String?
  reviewedBy           User?                  @relation("ChapterReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  muxData       MuxData?
  course        Course                 @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId      String
  userProgress  UserProgress[]
  activities    Activity[]
  quizBankItems QuizQuestionBankItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseId])
  @@index([reviewStatus])
}

enum ActivityType {
  VIDEO
  DOCUMENT
  DYNAMIC
  ASSIGNMENT
  QUIZ
}

enum ActivitySubType {
  VIDEO_YOUTUBE
  VIDEO_HOSTED
  DOCUMENT_PDF
  DYNAMIC_PAGE
  DYNAMIC_MARKDOWN
  QUIZ_MULTIPLE_CHOICE
}

/// Workflow brouillon â validation admin (optionnel via LMS_CONTENT_REVIEW_REQUIRED).
enum LmsContentReviewStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
}

model Activity {
  id          String          @id @default(uuid())
  name        String
  type        ActivityType
  subType     ActivitySubType
  content     Json            @default("{}")
  details     Json?           @default("{}")
  isPublished Boolean         @default(false)
  position    Int

  reviewStatus         LmsContentReviewStatus @default(APPROVED)
  submittedForReviewAt DateTime?
  reviewedAt           DateTime?
  reviewNote           String?                @db.Text
  reviewedById         String?
  reviewedBy           User?                  @relation("ActivityReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  chapterId String
  chapter   Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  assignment   Assignment?
  embeddings   CourseEmbedding[]
  quizAttempts QuizAttempt[]

  lastModifiedById String?
  lastModifiedBy   User?   @relation("ActivityModifier", fields: [lastModifiedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([chapterId])
  @@index([reviewStatus])
}

model MuxData {
  id         String  @id @default(uuid())
  assetId    String
  playbackId String?

  chapter   Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  chapterId String  @unique
}

/// Banque de questions QCM réutilisable (par formation ou cours LMS).
model QuizQuestionBank {
  id          String                 @id @default(uuid())
  title       String
  formationId String?
  formation   Formation?             @relation(fields: [formationId], references: [id], onDelete: Cascade)
  courseId    String?
  course      Course?                @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User                   @relation("QuizBankCreator", fields: [createdById], references: [id], onDelete: Cascade)
  items       QuizQuestionBankItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([formationId])
  @@index([courseId])
  @@index([createdById])
}

model QuizQuestionBankItem {
  id           String           @id @default(uuid())
  bankId       String
  bank         QuizQuestionBank @relation(fields: [bankId], references: [id], onDelete: Cascade)
  position     Int              @default(0)
  prompt       String           @db.Text
  /// Liste de réponses proposées (JSON string[]).
  choices      Json             @default("[]")
  correctIndex Int              @default(0)
  tags         String[]         @default([])
  /// UV LMS (chapitre) — banque QCM par unité de valeur.
  chapterId    String?
  chapter      Chapter?         @relation(fields: [chapterId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bankId])
  @@index([chapterId])
}

model UserProgress {
  id     String @id @default(uuid())
  userId String

  chapter     Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  chapterId   String
  isCompleted Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, chapterId])
  @@index([chapterId])
}

/// Tentative quiz portail candidat (correction serveur).
model QuizAttempt {
  id         String   @id @default(uuid())
  userId     String
  activityId String
  answers    Json     @default("{}")
  score      Int
  passed     Boolean
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@index([userId, activityId])
  @@index([activityId])
}

model Purchase {
  id     String @id @default(uuid())
  userId String

  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, courseId])
  @@index([courseId])
}

model StripeCustomer {
  id               String @id @default(uuid())
  userId           String @unique
  stripeCustomerId String @unique

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TrainingSession {
  id           String   @id @default(uuid())
  title        String
  description  String?  @db.Text
  startDate    DateTime
  endDate      DateTime
  location     String? // Salle de classe ou URL visioconférence
  instructorId String?
  instructor   User?    @relation("Instructor", fields: [instructorId], references: [id])

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  enrollments Enrollment[]
  attendances Attendance[]
  equipments  Equipment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseId])
  @@index([instructorId])
}

model Enrollment {
  id        String           @id @default(uuid())
  userId    String
  courseId  String
  sessionId String?
  status    EnrollmentStatus @default(PENDING)

  documents Json?   @default("[]") // Liste d'URLs pour le dossier d'admission
  notes     String? @db.Text

  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  course  Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  session TrainingSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, courseId, sessionId])
  @@index([userId])
  @@index([courseId])
  @@index([sessionId])
}

model Attendance {
  id        String           @id @default(uuid())
  userId    String
  sessionId String
  date      DateTime         @default(now())
  status    AttendanceStatus @default(PRESENT)

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  session TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, sessionId, date])
  @@index([userId])
  @@index([sessionId])
}

model Grade {
  id        String  @id @default(uuid())
  userId    String
  courseId  String
  chapterId String?
  value     Float // La note (ex: 15.5)
  weight    Float   @default(1.0) // Coefficient
  comment   String? @db.Text

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([courseId])
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  LOST
}

/// Cycle commercial d'un devis (module Finance).
enum FinanceDevisStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  REJECTED
  EXPIRED
}

/// Cycle e-facture (émission Factur-X / PDP) — distinct du statut commercial.
enum FinanceEinvoiceStatus {
  NOT_READY
  READY
  GENERATED
  QUEUED
  SENT
  ACCEPTED_BY_PDP
  REJECTED_BY_PDP
  FAILED
}

model Lead {
  id        String     @id @default(uuid())
  firstName String
  lastName  String
  email     String
  phone     String?
  source    String? // ex: "Landing Page", "Phone"
  status    LeadStatus @default(NEW)
  notes     String?    @db.Text

  courseId String? // Formation qui l'interesse
  course   Course? @relation(fields: [courseId], references: [id])

  /// Fiche catalogue CRM (`Formation`) pour les devis landing â distinct du cours LMS (`courseId`).
  formationId String?
  formation   Formation? @relation("LeadQuoteFormation", fields: [formationId], references: [id], onDelete: SetNull)

  candidature    Candidature?
  financeDevis   FinanceDevis[]
  supportTickets SupportTicket[]
  contact        Contact?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([status])
  @@index([formationId])
}

/// Devis / proposition commerciale (Finance), souvent rattaché à un lead landing devis.
model FinanceDevis {
  id            String             @id @default(uuid())
  referenceCode String             @unique
  title         String
  status        FinanceDevisStatus @default(DRAFT)

  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)

  formationId String?
  formation   Formation? @relation(fields: [formationId], references: [id], onDelete: SetNull)

  /// Dossier candidature CRM (optionnel) — ex. après conversion lead.
  candidatureId String?
  candidature   Candidature? @relation(fields: [candidatureId], references: [id], onDelete: SetNull)

  /// Session catalogue visée (optionnel).
  formationSessionId String?
  formationSession   FormationSession? @relation("FinanceDevisLinkedSession", fields: [formationSessionId], references: [id], onDelete: SetNull)

  /// Contexte client figé (entreprise, effectifs, modalité… — aligné formulaire landing).
  clientSnapshot Json @default("{}")
  /// Lignes [{ label, quantity, unitPriceHt, vatRate }]
  lines          Json @default("[]")

  subtotalHt Decimal @default(0) @db.Decimal(12, 2)
  vatTotal   Decimal @default(0) @db.Decimal(12, 2)
  totalTtc   Decimal @default(0) @db.Decimal(12, 2)
  currency   String  @default("EUR")

  validUntil    DateTime?
  notes         String?   @db.Text
  internalNotes String?   @db.Text

  /// Facturation électronique (réforme FR 2026) — export Factur-X / envoi PDP.
  einvoiceStatus       FinanceEinvoiceStatus @default(NOT_READY)
  /// MINIMUM | BASIC | EN16931 (profil Factur-X).
  einvoiceProfile      String                @default("BASIC")
  einvoiceGeneratedAt  DateTime?
  /// Identifiant retour PDP / plateforme (quand branchée).
  einvoicePdpMessageId String?
  einvoiceLastError    String?               @db.Text
  /// Snapshot XML Factur-X (CII) généré — FileAsset key optionnelle côté storage.
  einvoiceXmlAssetKey  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plaquetteMessages FinanceDevisPlaquetteMessage[]
  payments          FinancePayment[]

  @@index([leadId])
  @@index([status])
  @@index([formationId])
  @@index([candidatureId])
  @@index([formationSessionId])
  @@index([einvoiceStatus])
}

/// Message laissé par le client depuis la plaquette publique (lien signé) — consultable côté CRM.
model FinanceDevisPlaquetteMessage {
  id          String       @id @default(uuid())
  devisId     String
  devis       FinanceDevis @relation(fields: [devisId], references: [id], onDelete: Cascade)
  /// CLIENT | STAFF (réponses internes futures).
  authorKind  String       @default("CLIENT")
  body        String       @db.Text
  authorLabel String?
  createdAt   DateTime     @default(now())

  @@index([devisId, createdAt])
}

/// Lignes préremplies pour les devis : formations catalogue + prestations / frais saisis en base.
model FinanceCatalogLine {
  id String @id @default(uuid())

  /// FORMATION | PRESTATION | FRAIS | AUTRE
  category String @default("FORMATION")

  /// Renseigné et unique pour les lignes synchronisées avec une offre catalogue formation.
  formationId String?    @unique
  formation   Formation? @relation(fields: [formationId], references: [id], onDelete: Cascade)

  label       String
  description String? @db.Text

  defaultUnitPriceHt Decimal? @db.Decimal(12, 2)
  defaultVatRate     Decimal  @default(20) @db.Decimal(5, 2)
  currency           String   @default("EUR")

  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@index([category, isActive])
}

// Certifications
model Certification {
  id       String @id @default(uuid())
  courseId String
  config   Json   @default("{}") // Template, logo, signatures, etc.

  course           Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  userCertificates UserCertificate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseId])
}

model UserCertificate {
  id              String    @id @default(uuid())
  userId          String
  certificationId String
  certificateUrl  String?
  issueDate       DateTime  @default(now())
  expiryDate      DateTime?

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  certification Certification @relation(fields: [certificationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, certificationId])
  @@index([userId])
  @@index([certificationId])
}

// Community & Discussions
model Community {
  id          String  @id @default(uuid())
  name        String
  description String? @db.Text
  courseId    String? @unique

  course      Course?      @relation(fields: [courseId], references: [id])
  discussions Discussion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Discussion {
  id       String  @id @default(uuid())
  title    String
  content  String? @db.Text
  label    String? @default("general")
  emoji    String?
  isPinned Boolean @default(false)
  isLocked Boolean @default(false)

  authorId    String
  communityId String

  author    User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  community Community        @relation(fields: [communityId], references: [id], onDelete: Cascade)
  comments  Comment[]
  votes     DiscussionVote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([authorId])
  @@index([communityId])
}

model Comment {
  id           String  @id @default(uuid())
  content      String  @db.Text
  discussionId String
  authorId     String
  parentId     String? // Pour les réponses imbriquées

  discussion Discussion    @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  author     User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent     Comment?      @relation("CommentToComment", fields: [parentId], references: [id], onDelete: Cascade)
  replies    Comment[]     @relation("CommentToComment")
  votes      CommentVote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([discussionId])
  @@index([authorId])
  @@index([parentId])
}

model DiscussionVote {
  id           String @id @default(uuid())
  discussionId String
  userId       String
  value        Int    @default(1) // 1 pour upvote, -1 pour downvote

  discussion Discussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([discussionId, userId])
  @@index([discussionId])
  @@index([userId])
}

model CommentVote {
  id        String @id @default(uuid())
  commentId String
  userId    String
  value     Int    @default(1)

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@index([commentId])
  @@index([userId])
}

// Assignments
model Assignment {
  id          String    @id @default(uuid())
  title       String
  description String?   @db.Text
  dueDate     DateTime?
  maxPoints   Int       @default(100)

  activityId  String                 @unique
  activity    Activity               @relation(fields: [activityId], references: [id], onDelete: Cascade)
  submissions AssignmentSubmission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([activityId])
}

model AssignmentSubmission {
  id       String  @id @default(uuid())
  content  String? @db.Text // Texte du rendu ou lien
  fileUrl  String? // URL du fichier déposé
  grade    Float?
  feedback String? @db.Text

  assignmentId String
  userId       String

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([assignmentId, userId])
  @@index([assignmentId])
  @@index([userId])
}

// Billing & Usage Tracking
model ProductPack {
  id       String @id @default(uuid())
  type     String // ex: "ai_credits", "member_seats"
  packId   String // ex: "ai_500", "basic_subscription"
  quantity Int
  status   String @default("active") // active, cancelled

  activatedAt DateTime  @default(now())
  cancelledAt DateTime?

  platformSubscriptionId String? // ID Stripe ou autre plateforme

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UsageEvent {
  id         String @id @default(uuid())
  feature    String // ex: "members", "courses", "ai_tokens"
  eventType  String // ex: "add", "remove", "consume"
  usageAfter Int // Total après l'événement

  createdAt DateTime @default(now())

  @@index([feature, createdAt])
}

// Learning Paths & Collections
model Trail {
  id          String  @id @default(uuid())
  title       String
  description String? @db.Text
  userId      String // Créateur du parcours

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  steps TrailStep[]
  runs  TrailRun[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model TrailStep {
  id       String @id @default(uuid())
  trailId  String
  courseId String
  position Int

  trail  Trail  @relation(fields: [trailId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([trailId])
  @@index([courseId])
}

model TrailRun {
  id      String @id @default(uuid())
  trailId String
  userId  String
  status  String @default("in_progress") // in_progress, completed

  trail Trail @relation(fields: [trailId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([trailId])
  @@index([userId])
}

model Collection {
  id          String  @id @default(uuid())
  name        String
  description String? @db.Text
  isPublic    Boolean @default(true)

  courses Course[] @relation("CourseToCollection")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// External Integrations & Security
model ApiToken {
  id         String    @id @default(uuid())
  name       String
  token      String    @unique
  userId     String
  lastUsedAt DateTime?
  expiresAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model WebhookEndpoint {
  id          String  @id @default(uuid())
  url         String
  secret      String
  description String?
