model FileAsset {
  id               String              @id @default(uuid())
  module           String
  entityType       String
  entityId         String?
  category         String?
  originalName     String
  mimeType         String
  size             Int
  issuedAt         DateTime?
  expiresAt        DateTime?
  issuedBy         String?
  documentRef      String?
  storageKey       String              @unique
  url              String
  visibility       FileAssetVisibility @default(PRIVATE)
  status           FileAssetStatus     @default(ACTIVE)
  provider         String              @default("s3")
  metadata         Json?               @default("{}")
  createdById      String?
  currentVersionId String?             @unique
  archivedAt       DateTime?
  archiveReason    String?
  legalHold        Boolean             @default(false)
  retentionUntil   DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  deletedAt        DateTime?

  createdBy      User?              @relation("FileAssetCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  currentVersion FileAssetVersion?  @relation("FileAssetCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  versions       FileAssetVersion[] @relation("FileAssetVersions")
  reportJobs     ReportGenerationJob[]
  complianceDossierItems ComplianceDossierItem[]
  complianceItemEvents   ComplianceItemEvent[]
  ticketAttachments      TicketAttachment[]

  @@index([module, entityType, entityId])
  @@index([status, visibility])
  @@index([createdById])
  @@index([archivedAt])
}

model FileAssetVersion {
  id            String                 @id @default(uuid())
  fileAssetId   String
  versionNumber Int
  storageKey    String                 @unique
  url           String
  mimeType      String
  size          Int
  checksum      String?
  changeReason  String?
  status        FileAssetVersionStatus @default(ACTIVE)
  createdById   String?
  createdAt     DateTime               @default(now())

  fileAsset  FileAsset @relation("FileAssetVersions", fields: [fileAssetId], references: [id], onDelete: Cascade)
  currentFor FileAsset? @relation("FileAssetCurrentVersion")
  createdBy  User?     @relation("FileAssetVersionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([fileAssetId, versionNumber])
  @@index([fileAssetId, status])
}

/// Job asynchrone de gÃ©nÃ©ration document (PDF / Excel / CSV) â traitÃ© par @repo/workers.
model ReportGenerationJob {
  id            String             @id @default(uuid())
  templateKey   String
  format        ReportOutputFormat
  period        String
  periodStart   DateTime
  periodEnd     DateTime
  periodLabel   String
  title         String
  summary       String?
  status        ReportJobStatus    @default(PENDING)
  progress      Int                @default(0)
  errorMessage  String?
  renderToken   String             @unique @default(uuid())
  parameters    Json               @default("{}")
  fileAssetId   String?
  requestedById String
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  completedAt   DateTime?

  requestedBy User       @relation("ReportJobsRequested", fields: [requestedById], references: [id])
  fileAsset   FileAsset? @relation(fields: [fileAssetId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([requestedById])
  @@index([templateKey])
}

enum AiRunStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

enum AiArtifactStatus {
  PROPOSED
  APPROVED
  APPLIED
  REJECTED
}

/// ExÃ©cution d'une tÃ¢che IA (gÃ©nÃ©ration de programme, dÃ©roulÃ©, preuves Qualiopi...).
/// Le modÃ¨le ne touche jamais la base directement : il produit un ou plusieurs
/// AiArtifact que la fonction dÃ©terministe `apply*` correspondante valide et applique
/// aprÃ¨s revue humaine â jamais d'Ã©criture directe par le LLM (GSMS-AI-01).
model AiRun {
  id                String      @id @default(uuid())
  useCase           String
  status            AiRunStatus @default(PENDING)
  provider          String
  model             String
  inputSummary      Json        @default("{}")
  promptTokens      Int?
  completionTokens  Int?
  costCents         Int?
  errorMessage      String?
  requestedById     String
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  completedAt       DateTime?

  requestedBy User        @relation("AiRunsRequested", fields: [requestedById], references: [id])
  artifacts   AiArtifact[]

  @@index([status, createdAt])
  @@index([useCase])
  @@index([requestedById])
}

/// Sortie structurÃ©e proposÃ©e par un AiRun. Reste Ã  l'Ã©tat PROPOSED tant qu'un humain
/// ne l'a pas revue (reviewedById/reviewedAt) ; l'application effective (appliedAt) est
/// faite par du code dÃ©terministe, jamais par le modÃ¨le lui-mÃªme.
model AiArtifact {
  id               String           @id @default(uuid())
  runId            String
  status           AiArtifactStatus @default(PROPOSED)
  payload          Json
  citations        Json             @default("[]")
  targetEntityType String?
  targetEntityId   String?
  reviewedById     String?
  reviewedAt       DateTime?
  appliedAt        DateTime?
  createdAt        DateTime         @default(now())

  run        AiRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  reviewedBy User?  @relation("AiArtifactReviewed", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([runId])
  @@index([status])
  @@index([targetEntityType, targetEntityId])
}

/// Planification automatique des rapports (quotidien, mensuel, trimestriel).
model ReportGenerationSchedule {
  id          String                  @id @default(uuid())
  templateKey String
  format      ReportOutputFormat      @default(PDF)
  frequency   ReportScheduleFrequency
  title       String
  summary     String?
  parameters  Json                    @default("{}")
  enabled     Boolean                 @default(true)
  lastRunAt   DateTime?
  nextRunAt   DateTime?
  createdById String?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  @@index([enabled, nextRunAt])
  @@index([frequency])
}

