# Recommandé : une seule `.env` à la racine du monorepo avec DATABASE_URL (+ DIRECT_URL si besoin).
# `prisma.config.ts` charge automatiquement ce fichier (chemins ../../.env / cwd), comme le seed.
# Les scripts npm `db:generate`, `db:push`, … utilisent aussi `node --env-file=../../.env`.

# Alternative : copier ce fichier en `packages/database/.env` si vous préférez des secrets locaux au package.

DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/lms_app?schema=public"
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:5432/lms_app?schema=public"
