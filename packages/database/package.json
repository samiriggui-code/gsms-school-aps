{
  "name": "@repo/database",
  "version": "0.1.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./browser": "./src/browser.ts",
    "./landing-sections": "./src/landing-sections.ts",
    "./generated/client": "./generated/client"
  },
  "dependencies": {
    "@prisma/client-runtime-utils": "7.8.0",
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "bcrypt": "^6.0.0",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@repo/api-core": "workspace:*",
    "@types/pg": "^8.16.0",
    "prisma": "7.8.0",
    "tsx": "^4.21.0"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "node prisma/seed.js"
  },
  "scripts": {
    "db:push": "node --env-file=../../.env node_modules/prisma/build/index.js db push",
    "db:push:accept": "node --env-file=../../.env node_modules/prisma/build/index.js db push --accept-data-loss",
    "db:backfill-file-versions": "node --env-file=../../.env prisma/backfill-file-asset-versions.js",
    "db:backfill-compliance": "pnpm exec tsx --env-file=../../.env prisma/backfill-compliance-dossiers.ts",
    "db:generate": "node node_modules/prisma/build/index.js generate",
    "db:seed": "node prisma/seed.js",
    "db:migrate": "node --env-file=../../.env node_modules/prisma/build/index.js migrate deploy",
    "db:migrate:dev": "node --env-file=../../.env node_modules/prisma/build/index.js migrate dev",
    "db:studio": "node --env-file=../../.env node_modules/prisma/build/index.js studio"
  }
}
